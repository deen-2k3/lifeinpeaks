# ── Database ──────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/lifeinpeaks?schema=public"

# ── Site ──────────────────────────────────────────────────
# Public URL, used for canonical URLs, sitemap and Open Graph tags
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional: fallback name before the DB is seeded (the real name is edited in Admin → Settings)
# NEXT_PUBLIC_SITE_NAME="Lifeinpeaks"

# ── Admin authentication ──────────────────────────────────
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Used by `npm run db:seed` to create the first admin (or use `npm run admin:create`)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# ── Image storage ─────────────────────────────────────────
# "local" (default) or "cloudinary"
STORAGE_PROVIDER="local"
# Local provider: where originals + optimised variants are written (must be persistent in production)
UPLOAD_DIR="./storage"
# Optional CDN in front of /media (e.g. https://cdn.example.com). Leave empty to serve from this app.
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Cloudinary provider
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lifeinpeaks"

# ── Optional ──────────────────────────────────────────────
# Instagram API (Instagram Login) long-lived token. Without it, the homepage shows your featured photos.
INSTAGRAM_ACCESS_TOKEN=""
# Map tiles (defaults to CARTO dark)
# NEXT_PUBLIC_MAP_TILES="https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png"
